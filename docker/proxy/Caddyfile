# Reverse proxy of the production stack (docker-compose.prod.yml): the only entry from outside.
#
# Two sites on two origins:
#   API      {$API_SITE_ADDRESS}      -> api:8080            /api/* and /health only
#   storage  {$STORAGE_SITE_ADDRESS}  -> objectstorage:8333  the S3 API, for presigned links
#
# A site address that is a host name (api.example.com) gets HTTPS with an automatic certificate; the defaults
# (http://:8080, http://:8081) are plain HTTP for a tunnel that ends TLS in front of this proxy.
{
	# No admin endpoint: the configuration is this file.
	admin off

	servers {
		# Who may say on whose behalf a request arrives (X-Forwarded-For / -Proto): the tunnel in front of this proxy,
		# when there is one. From everybody else these headers are overwritten. The default trusts nobody that can
		# reach this container.
		trusted_proxies static {$PROXY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# Access log of both sites: no query string - the realtime hub carries the access token there and a presigned link
# its signature - and no credential header.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*" ""
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Referer delete
				# What Tailscale adds for a device of the tailnet: the login, name and picture of its user.
				request>headers>Tailscale-User-Login delete
				request>headers>Tailscale-User-Name delete
				request>headers>Tailscale-User-Profile-Pic delete
				resp_headers>Location regexp "\?.*" ""
			}
		}
	}
}

# The identity headers Tailscale adds to a request from a device of the tailnet never reach an upstream: nothing
# behind this proxy uses them, and nobody may mistake them for an authentication.
(strip_tailscale_identity) {
	request_header -Tailscale-User-Login
	request_header -Tailscale-User-Name
	request_header -Tailscale-User-Profile-Pic
}

{$API_SITE_ADDRESS:http://:8080} {
	import access_log
	import strip_tailscale_identity

	@api path /api/* /health
	handle @api {
		# A backstop only: 8 x the API's own limit for a request body (RequestBodyLimit.MaxBytes, 128 KiB; a test of the
		# backend asserts the relation). Every body the API refuses for its size therefore reaches the API, which answers
		# a 413 the frontend can read (CORS header, problem document, correlation id). With equal limits the answer
		# was a race: this proxy only fails when it reads past its limit, and then with a bare 413. Above 1 MiB the
		# proxy refuses by itself.
		request_body {
			max_size 1024KiB
		}

		# WebSocket upgrades of /api/hubs/* pass through as they are. The API gets exactly one client address: the
		# one this proxy determined (the peer, or what a trusted tunnel reported).
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Nothing else is served here.
	handle {
		respond 404
	}
}

{$STORAGE_SITE_ADDRESS:http://:8081} {
	import access_log
	import strip_tailscale_identity

	# The Host header is passed on unchanged (Caddy's default) and the path is not rewritten: a presigned link is
	# signed for exactly this host and path. Bodies are streamed, not buffered: an upload of several megabytes goes
	# straight through - no size limit here (the API checks the size of an image when it is confirmed).
	reverse_proxy objectstorage:8333 {
		# An object is data, whatever type it was stored with: never sniffed into another type and never run as a
		# page on this origin (an image is still shown and a file still downloaded by a page of the frontend).
		header_down X-Content-Type-Options nosniff
		header_down Content-Security-Policy "default-src 'none'; sandbox"
	}
}

# For the container health check only; not published.
http://:8090 {
	respond /healthz 200
}
