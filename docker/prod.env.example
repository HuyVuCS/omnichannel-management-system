# Template of the environment file of the production stack (docker/docker-compose.prod.yml). No value here is real.
# Do not copy it by hand: scripts\deploy\new-prod-env.ps1 writes docker/.env.prod (git-ignored) with fresh random values
# for every password and key. Passwords and keys are letters and digits only: they are substituted into the compose file
# and into Npgsql connection strings ('$', ';' and quotes would break either).

# --- Images -----------------------------------------------------------------------------------------------------------
# Tag of the images of this stack (omnichannel-api, -workers, -migrate). Production: the short commit of the release
# (12 characters, runbook "Release"); the previous value is what a rollback puts back. Any other stack on the machine
# has its own tag (the generator writes local-<8 random characters>), so building one never changes what another runs.
IMAGE_TAG=

# --- Where the browsers come from and what they reach -----------------------------------------------------------------
# Origin of the frontend, exactly as a browser sends it (scheme, host, port; no path, no trailing slash). The only origin
# the API answers with CORS headers and the only one the storage bucket allows.
FRONTEND_ORIGIN=
# Public origin of the storage site of the proxy (what a browser can reach). Presigned links are signed for it.
# Without TLS and a tunnel: http://localhost:8081 (STORAGE_PORT below). With host names: https://files.example.com
STORAGE_PUBLIC_URL=

# --- Reverse proxy ----------------------------------------------------------------------------------------------------
# Site addresses of the proxy. Plain HTTP on two ports (default; a tunnel ends TLS in front), or two host names for
# automatic HTTPS (then also add -f docker/docker-compose.prod.tls.yml).
API_SITE_ADDRESS=http://:8080
STORAGE_SITE_ADDRESS=http://:8081
# Host interface and ports of the proxy without TLS. 127.0.0.1: reachable from this machine only (the tunnel).
PROXY_BIND=127.0.0.1
API_PORT=8080
STORAGE_PORT=8081
# Networks whose X-Forwarded-For / X-Forwarded-Proto the proxy believes (CIDR, space separated): the tunnel in front of
# it. A tunnel on this machine arrives from the gateway of the edge network (default 172.30.250.1/32). The default
# trusts nobody.
PROXY_TRUSTED_PROXIES=127.0.0.1/32
# true: a request that reached the edge without TLS is redirected to HTTPS. false only for a stack without TLS anywhere.
API_HTTPS_REDIRECT=true
# Network of the proxy, its gateway (where a tunnel on this machine arrives from) and the fixed address of the proxy
# (the only one the API believes forwarded headers from). Change the four together, and only when the subnet is taken
# on this machine.
EDGE_SUBNET=172.30.250.0/28
EDGE_GATEWAY=172.30.250.1
EDGE_DYNAMIC_RANGE=172.30.250.8/29
PROXY_IP=172.30.250.2

# --- PostgreSQL -------------------------------------------------------------------------------------------------------
# Superuser (container administration only - never used by the application)
POSTGRES_PASSWORD=
# Role that owns the schema and runs the migrations (service "migrate")
OMNI_MIGRATOR_PASSWORD=
# Runtime role of API and Workers (DML only)
OMNI_APP_PASSWORD=

# --- RabbitMQ ---------------------------------------------------------------------------------------------------------
RABBITMQ_USER=omnichannel
RABBITMQ_PASSWORD=

# --- API --------------------------------------------------------------------------------------------------------------
# HMAC-SHA256 signing key of the access tokens, at least 256 bits
JWT_SIGNING_KEY=
# The first Admin, created on API start-up when that user does not exist yet. There is no self-service password change:
# another Admin resets a password under Users.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Secrets the three channels sign their webhooks with (README "Webhooks"), at least 32 characters each
WEBHOOK_SECRET_WEBSITE=
WEBHOOK_SECRET_POS=
WEBHOOK_SECRET_DIGITAL_PLATFORM=

# --- Workers ----------------------------------------------------------------------------------------------------------
# Number of Workers instances that "up" starts (production: 2). A task is processed once whatever the number.
WORKERS_REPLICAS=1

# --- Object storage (SeaweedFS in the stack) --------------------------------------------------------------------------
OBJECT_STORAGE_BUCKET=omnichannel
# 20 and 40 letters or digits
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
