# Copy to docker/.env and replace every value. docker/.env is git-ignored.
# Avoid ';' and quotes in passwords: they are embedded in Npgsql connection strings.

# PostgreSQL superuser (container administration only - never used by the application)
POSTGRES_PASSWORD=change-me-superuser
# Role that owns the schema and runs EF Core migrations
OMNI_MIGRATOR_PASSWORD=change-me-migrator
# Runtime role for API/Workers (DML only)
OMNI_APP_PASSWORD=change-me-app

RABBITMQ_USER=omnichannel
RABBITMQ_PASSWORD=change-me-rabbit

# HMAC-SHA256 signing key, at least 32 bytes. Generate e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-base64-string-of-at-least-32-bytes

# Optional: create the first Admin user on API start-up (only if that user does not exist yet).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
