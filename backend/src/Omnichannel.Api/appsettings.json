{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Properties": {
      "Application": "Omnichannel.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "omnichannel-api",
    "Audience": "omnichannel-dashboard",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
