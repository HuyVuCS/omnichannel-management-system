{
  "permissions": {
    "allow": [
      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet tool restore:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations script:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet list package:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)"
    ],
    "deny": [
      "Read(./docker/.env)",
      "Read(./**/.env)",
      "Read(./**/secrets.json)"
    ]
  }
}
